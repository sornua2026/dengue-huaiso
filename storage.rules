rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function enabledUser() {
      return request.auth != null && userProfile().enabled == true;
    }
    function admin() {
      return enabledUser() && userProfile().role == "admin";
    }
    function validVillage(village) {
      return village in ["1","2","12","16","18","19"];
    }
    function canAccessVillage(village) {
      return admin()
        || (enabledUser() && userProfile().role == "vhw"
            && userProfile().village == village);
    }

    // /surveyPhotos/{village}/{month_village}/{uploaderUid}/{fileName}
    match /surveyPhotos/{village}/{surveyId}/{uploaderUid}/{fileName} {
      allow read: if validVillage(village)
        && canAccessVillage(village)
        && surveyId.matches('^[0-9]{4}-(0[1-9]|1[0-2])_' + village + '$');

      allow write: if request.resource != null
        && resource == null
        && validVillage(village)
        && canAccessVillage(village)
        && request.auth.uid == uploaderUid
        && surveyId.matches('^[0-9]{4}-(0[1-9]|1[0-2])_' + village + '$')
        && fileName.matches('^[A-Za-z0-9_-]+\\.jpg$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == "image/jpeg";

      allow delete: if validVillage(village)
        && (admin() || (canAccessVillage(village) && request.auth.uid == uploaderUid));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}